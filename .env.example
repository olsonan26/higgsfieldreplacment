# Public application configuration. The publishable key is intentionally safe
# for browser use; authorization still depends on Supabase Auth and RLS.
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_replace_me

# Server-only credentials. Never prefix these with NEXT_PUBLIC, commit values,
# log values, or copy them into browser cookies/localStorage.
SUPABASE_SECRET_KEY=sb_secret_replace_me
GENERATION_PROVIDER_API_KEY=replace_me
GENERATION_PROVIDER_BASE_URL=https://generation-provider.example.invalid
GENERATION_PROVIDER_WEBHOOK_HMAC_KEY=replace_with_the_dashboard_webhook_hmac_key

# Callback/reconciliation and output-ingestion controls.
CRON_SECRET=replace_with_at_least_32_random_characters
RESULT_ALLOWED_HOSTS=results.example.invalid
MAX_SOURCE_UPLOAD_BYTES=104857600
MAX_GENERATED_IMAGE_BYTES=52428800
MAX_GENERATED_VIDEO_BYTES=1073741824

# No-secret observability defaults to structured console output.
LOG_LEVEL=info

# This smoke test is opt-in and must always have a hard micro-budget.
ENABLE_REAL_PROVIDER_SMOKE=false
REAL_PROVIDER_SMOKE_MAX_CREDITS=1

# Only for the explicit, manually supervised smoke command. Supply these at
# invocation time; never store an authentication cookie in a committed file.
# REAL_PROVIDER_SMOKE_APP_URL=https://your-deployment.example
# REAL_PROVIDER_SMOKE_AUTH_COOKIE=provide_at_invocation
# REAL_PROVIDER_SMOKE_PAYLOAD_FILE=./private/smoke-payload.json
